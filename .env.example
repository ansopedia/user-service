# Application Configuration
APP_PORT=8000                                    # Port number for the application server
PINO_LOG_LEVEL=info                             # Log level (trace/debug/info/warn/error/fatal)

# Database Configuration
DATABASE_URI=mongodb://localhost:27017/          # MongoDB connection URL
DB_NAME=users-service           

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=default
REDIS_DB=0
REDIS_USERNAME=default

# JWT Configuration
JWT_ISSUER=user-service                            # 
JWT_AUDIENCE=my-apps
ACTION_TOKEN_SECRET=actionToken                    # Secret key for action-specific tokens
ACCESS_TOKEN_EXPIRES_IN=15m                        # Expiration time for access tokens (e.g., 15m, 1h)
REFRESH_TOKEN_EXPIRES_IN=7d                        # Expiration time for refresh tokens (e.g., 7d, 30d)
ACTION_TOKEN_EXPIRES_IN=15m                        # Expiration time for action tokens(e.g., 5min, 15m )

# Authentication Configuration
MASTER_OTP=111111                               # Master OTP for development/testing

# Default Super Admin Configuration
DEFAULT_SUPER_ADMIN_USERNAME=superusername            # Default username for super admin
DEFAULT_SUPER_ADMIN_EMAIL=superusername@gmail.com     # Default email for super admin
DEFAULT_SUPER_ADMIN_PASSWORD=Superusername@123            # Default password for super admin

# Microservices URLs
NOTIFICATION_SERVICE_BASE_URL=http://localhost:8002  # Base URL for notification service
USER_SERVICE_BASE_URL=http://localhost:8001         # Base URL for user service

# Google OAuth Configuration
GOOGLE_CLIENT_ID=yourId.apps.googleusercontent.com      # Google OAuth client ID
GOOGLE_CLIENT_SECRET=google-client-secret              # Google OAuth client secret
GOOGLE_CLIENT_URL=http://localhost:8001/api/v1/auth/google/callback  # Google OAuth callback URL

# CORS Configuration
CLIENT_URL=http://localhost:3000                 # Frontend client URL

