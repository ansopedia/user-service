{
  "name": "user",
  "version": "2.0.0",
  "description": "user service for ansopedia",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "local": "cross-env NODE_ENV=local nodemon",
    "local:dev": "cross-env NODE_ENV=development nodemon",
    "local:prod": "cross-env NODE_ENV=production pnpm prod",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "generate-env": "tsx scripts/generate-env-files.ts",
    "migrate": "tsx -r tsconfig-paths/register src/config/migrate.ts",
    "migrate:local": "cross-env NODE_ENV=local pnpm migrate",
    "migrate:prod": "cross-env NODE_ENV=production pnpm migrate",
    "setup": "tsx scripts/setup-project.ts",
    "lint:fix": "eslint --fix .",
    "lint": "eslint src .",
    "prepare": "husky",
    "pretest": "pnpm build",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prod": "pnpm build && pnpm start",
    "start": "node dist/index.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
  },
  "keywords": [
    "user",
    "ansopedia"
  ],
  "author": "ansopedia",
  "license": "ISC",
  "dependencies": {
    "@ansospace/eslint-config": "file://F:\\projects\\ansospace\\packages\\eslint-config",
    "@ansospace/types": "file://F:\\projects\\ansospace\\packages\\types",
    "axios": "1.13.2",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.3",
    "maxmind": "5.0.1",
    "mongoose": "9.0.2",
    "morgan": "1.10.1",
    "ms": "2.1.3",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.1",
    "ua-parser-js": "2.0.7",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-check-file": "3.3.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "nodemon": "3.1.11",
    "pino-pretty": "13.1.3",
    "prettier": "3.7.4",
    "supertest": "7.1.4",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "4.0.16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,md}": [
      "prettier --write .",
      "eslint --fix ."
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.25.0"
}
